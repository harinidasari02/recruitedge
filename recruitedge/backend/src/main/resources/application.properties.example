# Copy this file to application.properties and fill in your MySQL credentials
spring.datasource.url=jdbc:mysql://localhost:3306/recruitedge?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
spring.datasource.username=YOUR_DB_USER
spring.datasource.password=YOUR_DB_PASSWORD
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
server.port=8080
